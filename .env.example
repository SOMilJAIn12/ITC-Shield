# ITC Shield - backend environment variables (copy to backend/.env or set in your host's dashboard).
# Everything here is read by the FastAPI backend only. Nothing in this file is ever sent to the browser.

# ---- AI Investigation Brief ---------------------------------------------------------------------------
# Optional. Without a key the app still works: briefs use the deterministic evidence-based fallback.
# PREFERRED PROVIDER: Groq (OpenAI-compatible chat-completions API). Get a key from the Groq console; whether usage is
# free or billed depends on your Groq account/plan - ITC Shield makes no claim about that.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Model (default for groq: llama-3.3-70b-versatile; e.g. llama-3.1-8b-instant for a faster/cheaper option)
LLM_MODEL=
# Base URL (default for groq: https://api.groq.com/openai/v1). Also works with any OpenAI-compatible server, e.g. Ollama http://localhost:11434/v1
LLM_BASE_URL=
# Other supported providers (only if you do not use Groq): LLM_PROVIDER=anthropic|openai with the matching key.
# LLM_PROVIDER=auto picks groq, then anthropic, then openai, whichever key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Seconds to wait for the LLM before falling back
LLM_TIMEOUT=25

# ---- Production / deployment (Phase 7) --------------------------------------------------------------
# Comma-separated list of allowed browser origins. Leave empty for local development (allows all origins).
# Example: CORS_ORIGINS=https://itc-shield.vercel.app,https://itc-shield.netlify.app
CORS_ORIGINS=
# Port is usually injected by the host (Render/Railway/Fly set PORT automatically).
PORT=8000
